/* Zelda3D PC HUD — always-on overlay rendered via RmlUi every gameplay frame.
   Design: minimal, modern PC game HUD.  No box-shadow / backdrop-filter / opacity()
   (VK render interface doesn't implement the layer path — would corrupt the frame).
   Uses rgba() for translucency, border-radius for shape, gradients as decorators. */

* {
	box-sizing: border-box;
}

body {
	display: block;
	width:  100%;
	height: 100%;
	/* NO background-color — transparent so the game world shows through */
	font-family: LatoLatin;
	font-weight: bold;
	font-size: 16px;
	color: #FFFFFF;
}

/* ---- Corners helper -------------------------------------------------------- */
/* All HUD panels are position:absolute anchored to the four corners.           */

.hud-corner {
	position: absolute;
}

.hud-tl {
	top:    16px;
	left:   16px;
}

.hud-bl {
	bottom: 16px;
	left:   16px;
}

.hud-br {
	bottom: 16px;
	right:  16px;
}

/* ---- Hearts (health meter) ------------------------------------------------- */

#hud-health {
	/* transparent pill so the hearts sit cleanly over the world */
}

#hearts-row {
	display: block;
	/* Hearts are injected as <hrt> siblings, displayed inline. */
}

/* Each heart: a small coloured box.  Full colours from OoT3D's UI palette:
   full  = warm red,  partial fills dim toward grey,  empty = dark grey. */
hrt {
	display: inline-block;
	width:   20px;
	height:  20px;
	margin:  2px;
	border-radius: 4px;
	/* Drop shadow via border (VK-safe — no box-shadow) */
	border: 1px rgba(0, 0, 0, 60%);
}

hrt.full {
	background-color: #E83030;
	decorator: vertical-gradient(#FF5050 #C02020);
}

hrt.threequarter {
	background-color: #D04820;
	decorator: vertical-gradient(#E06030 #B03010);
}

hrt.half {
	background-color: #B06010;
	decorator: vertical-gradient(#C07820 #904800);
}

hrt.quarter {
	background-color: #906020;
	decorator: vertical-gradient(#A07030 #705010);
}

hrt.empty {
	background-color: rgba(255, 255, 255, 18%);
	decorator: vertical-gradient(rgba(255,255,255,25%) rgba(255,255,255,10%));
}

/* ---- Magic bar ------------------------------------------------------------- */

.hud-magic-block {
	top: 64px; /* just below the hearts row (3 rows of hearts + gap) */
	left: 16px;
}

#magic-bar-bg {
	display: block;
	width:  120px;
	height:   8px;
	border-radius: 4px;
	background-color: rgba(0, 30, 60, 50%);
	border: 1px rgba(0, 100, 200, 40%);
	overflow: hidden;
}

#magic-bar-fill {
	display: block;
	height: 100%;
	width:  100%;   /* overridden inline by SohRmlUi: style="width: N%" */
	background-color: #40C0FF;
	decorator: horizontal-gradient(#60DFFF #2090C0);
	border-radius: 4px;
}

/* ---- Rupee counter --------------------------------------------------------- */

#hud-rupees {
	display: block;
}

#rupee-gem {
	font-size: 20px;
	color: #50FF70;
	/* the ♦ unicode diamond stands in for the faceted rupee gem */
	margin-right: 4px;
}

#rupee-count {
	font-size: 22px;
	color: #FFFFFF;
	/* thin text-shadow via font-effect glow for legibility over the world */
	font-effect: glow(0px 2px 0px 2px rgba(0,0,0,80%));
}

/* ---- Item action bar ------------------------------------------------------- */

#hud-items {
	display: block;
}

.item-slot {
	display: inline-block;
	width:   52px;
	height:  52px;
	margin:  4px;
	border-radius: 8px;
	background-color: rgba(0, 0, 0, 45%);
	border: 1px rgba(255, 255, 255, 20%);
	vertical-align: bottom;
	position: relative;
}

/* B slot: slightly larger + green accent to match OoT convention */
#slot-b {
	width:  58px;
	height: 58px;
	border: 2px rgba(60, 220, 60, 60%);
}

/* C slots: yellow accent */
#slot-cleft, #slot-cdown, #slot-cright {
	border: 1px rgba(255, 210, 40, 40%);
}

.item-icon {
	display: block;
	width:   100%;
	height:  76%;
	/* Item name text is shown below; the icon cell is reserved for a future
	   RmlUi texture-decorator once the item icon textures are wired up. */
	text-align: center;
	font-size: 11px;
	color: rgba(255, 255, 255, 40%);
	overflow: hidden;
}

.item-label {
	display: block;
	position: absolute;
	bottom:  2px;
	right:   4px;
	font-size: 11px;
	font-weight: bold;
	color: rgba(255, 255, 255, 60%);
}

/* Keyboard glyph style — shown when gZelda3dInputDevice==1 */
.item-label.kbd {
	color: #FFD82A;
	font-size: 10px;
}

/* ---- Empty item slot ------------------------------------------------------- */
.item-slot.empty {
	background-color: rgba(0, 0, 0, 25%);
	border-color: rgba(255, 255, 255, 10%);
}
