<rml>
<head>
	<title>Zelda3D HUD</title>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="zelda3d_hud.rcss"/>
</head>
<body>
	<!-- Top-left: health (hearts) -->
	<div id="hud-health" class="hud-corner hud-tl">
		<div id="hearts-row">
			<!-- Heart cells are injected by SohRmlUi::UpdateHud() as:
			     <hrt class="full|threequarter|half|quarter|empty"/> per heart container -->
		</div>
	</div>

	<!-- Top-left below hearts: magic bar (hidden when magicLevel==0) -->
	<div id="hud-magic" class="hud-corner hud-tl hud-magic-block">
		<div id="magic-bar-bg">
			<div id="magic-bar-fill"></div>
		</div>
	</div>

	<!-- Bottom-left: rupee counter -->
	<div id="hud-rupees" class="hud-corner hud-bl">
		<span id="rupee-gem">&#9830;</span>
		<span id="rupee-count">0</span>
	</div>

	<!-- Bottom-right: item action bar  B + C-Left + C-Down + C-Right -->
	<div id="hud-items" class="hud-corner hud-br">
		<div class="item-slot" id="slot-b">
			<div class="item-icon" id="icon-b"></div>
			<div class="item-label" id="label-b">B</div>
		</div>
		<div class="item-slot" id="slot-cleft">
			<div class="item-icon" id="icon-cleft"></div>
			<div class="item-label" id="label-cleft">C&#9664;</div>
		</div>
		<div class="item-slot" id="slot-cdown">
			<div class="item-icon" id="icon-cdown"></div>
			<div class="item-label" id="label-cdown">C&#9660;</div>
		</div>
		<div class="item-slot" id="slot-cright">
			<div class="item-icon" id="icon-cright"></div>
			<div class="item-label" id="label-cright">C&#9654;</div>
		</div>
	</div>
</body>
</rml>
